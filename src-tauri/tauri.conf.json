{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZenTauri",
  "version": "1.3.0",
  "identifier": "org.zentauri.app",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZenTauri",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: ipc:; img-src 'self' asset: tauri: zen: zen-asset: data: blob: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data: https:; connect-src 'self' ipc: tauri: ws: http: https:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFNjc4MDE5MEEzNTJGNTAKUldSUUx6VUtHWUJucmhOYm5keXBFMnFTckdSdk9PQktJNzVub0dtNUltTHhqVEhWWHlmcnJhV04K",
      "endpoints": [
        "https://github.com/marcodem/zentauri/releases/latest/download/latest.json"
      ]
    }
  }
}
