{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZenTauri",
  "version": "1.1.6",
  "identifier": "org.zentauri.app",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZenTauri",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFNjc4MDE5MEEzNTJGNTAKUldSUUx6VUtHWUJucmhOYm5keXBFMnFTckdSdk9PQktJNzVub0dtNUltTHhqVEhWWHlmcnJhV04K",
      "endpoints": [
        "https://github.com/marcodem/zentauri/releases/latest/download/latest.json"
      ]
    }
  }
}
